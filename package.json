{
  "name": "opencluely",
  "version": "1.0.0",
  "description": "AI Problem Solving Assistant",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/start-electron.cjs",
    "desktop": "node scripts/start-electron.cjs",
    "dev": "node scripts/start-electron.cjs --no-sandbox --disable-gpu",
    "mobile": "npm --prefix mobile start",
    "phone": "npm --prefix mobile start",
    "desktop:phone": "node scripts/start-desktop-phone.cjs",
    "test-mobile-services": "node scripts/test-mobile-services.cjs",
    "capture-diagnostic": "node scripts/start-electron.cjs --script scripts/check-screen-capture.cjs",
    "test-mobile-main": "node scripts/start-electron.cjs --script scripts/test-mobile-main.cjs",
    "test": "node scripts/test-screenshot-queue.cjs && node scripts/test-resume-context.cjs && node scripts/test-audio-routing.cjs && node scripts/test-web-primitives.cjs && node scripts/test-mobile-services.cjs && node scripts/test-listening-toggle.cjs && node scripts/test-openai.cjs && node scripts/test-live-transcription.cjs && node scripts/test-conversation-pipeline.cjs && node scripts/test-force-send.cjs && node scripts/test-swe-behavioral.cjs && node scripts/test-case-mode.cjs && node scripts/test-plain-response.cjs && node scripts/test-mobile-image-upload.cjs",
    "test-listening": "node scripts/test-listening-toggle.cjs",
    "test-speech": "node scripts/test-speech.js",
    "test-resume-context": "node scripts/test-resume-context.cjs",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux",
    "dist": "npm run build",
    "pack": "electron-builder --dir",
    "clean": "node scripts/clean.cjs",
    "rebuild": "npm run clean && npm run build",
    "release": "npm run clean && npm run build:all",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "test:live-conversation": "node scripts/check-live-conversation.cjs",
    "test:swe": "node scripts/test-swe-behavioral.cjs",
    "evaluate:swe": "node scripts/evaluate-swe-behavioral.cjs",
    "test:case": "node scripts/test-case-mode.cjs",
    "test:live-case": "node scripts/check-live-case-mode.cjs",
    "test:plain-text": "node scripts/test-plain-response.cjs"
  },
  "author": {
    "name": "TechyCSR",
    "email": "info@techycsr.dev",
    "url": "https://techycsr.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TechyCSR/OpenCluely"
  },
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@google/genai": "^2.9.0",
    "busboy": "^1.6.0",
    "dotenv": "^16.3.1",
    "markdown": "^0.5.0",
    "marked": "^15.0.12",
    "microsoft-cognitiveservices-speech-sdk": "^1.40.0",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^7.39.0",
    "prismjs": "^1.30.0",
    "sharp": "^0.35.5",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.opencluely.app",
    "productName": "OpenCluely",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!*.md",
      "!.git/**/*",
      "!.env*",
      "!.venv-whisper/**/*",
      "!.whisper-models/**/*",
      "!eng.traineddata",
      "!artifacts/**/*",
      "!mobile/**/*",
      "!bin/**/*",
      "!scripts/__pycache__/**/*",
      "!**/*.pyc"
    ],
    "asarUnpack": [
      "assests/icons/**/*",
      "prompts/**/*",
      "scripts/transcribe-whisper.py",
      "scripts/whisper_worker.py",
      "scripts/mouse-routing.ps1",
      "scripts/capture-window-metadata.ps1",
      "scripts/backtick-key-listener.ps1"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "OpenCluely uses the microphone to transcribe your speech locally with Whisper.",
        "NSCameraUsageDescription": "OpenCluely does not record video; this entitlement is only present for media-capture compatibility.",
        "NSScreenCaptureUsageDescription": "OpenCluely captures the screen to read on-screen content for AI assistance."
      }
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assests/icons/app-icon.png",
      "category": "Utility"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xauth",
        "libasound2t64",
        "libgbm1",
        "python3 (>= 3.10)",
        "python3-venv",
        "python3-pip"
      ],
      "recommends": [
        "ffmpeg"
      ],
      "fpm": [
        "--after-install=scripts/post-install-deb.sh"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "include": "scripts/post-install-nsis.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "OpenCluely-Setup-${version}.${ext}"
    },
    "dmg": {
      "title": "OpenCluely Interview Assistant",
      "backgroundColor": "#000000",
      "window": {
        "width": 600,
        "height": 400
      }
    }
  }
}
