{
  "expo": {
    "name": "OpenCluely Remote",
    "slug": "opencluely-remote",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "opencluely",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Select images to attach to your OpenCluely conversation.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to OpenCluely on your private local network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
