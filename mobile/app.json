{
  "expo": {
    "name": "OpenCluely Remote",
    "slug": "opencluely-remote",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "opencluely",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to OpenCluely on your private local network."
      }
    },
    "android": {},
    "experiments": {
      "typedRoutes": true
    }
  }
}
